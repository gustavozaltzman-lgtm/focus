NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/focus?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Una sola key:
ANTHROPIC_API_KEY=
# O varias, separadas por coma, para repartir carga y hacer failover si una
# se queda sin cupo/rate-limited (si se define, tiene prioridad sobre la de arriba):
# ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Clave simétrica (32 bytes en base64, ej. `openssl rand -base64 32`) usada
# para cifrar en reposo la API key personal que cada usuario puede cargar
# desde Configuración. Sin esto, esa función queda deshabilitada (503).
ENCRYPTION_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Focus
WEBAUTHN_ORIGIN=http://localhost:5173
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@focus.app
